<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ks_it_assets.Dashboard" owl="1">
        <div class="o_action_manager">
            <div class="container-fluid py-4" style="background-color: var(--ks-it-secondary); min-height: 100vh;">
                
                <!-- Başlık -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h2 class="text-white" style="font-weight: 700;">KS IT Asset Manager <span class="text-muted fs-4">/ Dashboard</span></h2>
                        <p class="text-muted">Kaleseramik Bilgi Teknolojileri Varlık ve Zimmet Yönetimi Özeti</p>
                    </div>
                </div>

                <!-- Özet Kartları -->
                <div class="row g-4 mb-4">
                    <!-- Toplam Varlık -->
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; cursor: pointer;" t-on-click="() => this.openAssets([], 'Tüm Varlıklar')">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: rgba(99, 102, 241, 0.1);">
                                    <i class="fa fa-laptop fa-lg text-primary" style="color: var(--ks-it-primary) !important;"></i>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Toplam IT Varlığı</h6>
                                    <h3 class="mb-0 text-white fw-bold"><t t-esc="state.stats.total_assets"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Boşta -->
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; cursor: pointer;" t-on-click="() => this.openAssets([['status', '=', 'available']], 'Boştaki Varlıklar')">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: rgba(34, 197, 94, 0.1);">
                                    <i class="fa fa-check-circle fa-lg text-success" style="color: var(--ks-it-success) !important;"></i>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Boşta / Depoda</h6>
                                    <h3 class="mb-0 text-white fw-bold"><t t-esc="state.stats.available_assets"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Zimmetli -->
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; cursor: pointer;" t-on-click="() => this.openAssets([['status', '=', 'assigned']], 'Zimmetli Varlıklar')">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: rgba(245, 158, 11, 0.1);">
                                    <i class="fa fa-user fa-lg text-warning" style="color: var(--ks-it-warning) !important;"></i>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Kullanımda</h6>
                                    <h3 class="mb-0 text-white fw-bold"><t t-esc="state.stats.assigned_assets"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tamirde -->
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; cursor: pointer;" t-on-click="() => this.openAssets([['status', '=', 'repair']], 'Tamirdeki Varlıklar')">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: rgba(239, 68, 68, 0.1);">
                                    <i class="fa fa-wrench fa-lg text-danger" style="color: var(--ks-it-danger) !important;"></i>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Tamirde / Serviste</h6>
                                    <h3 class="mb-0 text-white fw-bold"><t t-esc="state.stats.in_repair"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Aksiyon Kartları -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; border-left: 4px solid var(--ks-it-primary) !important;">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="text-white mb-1">Aktif Zimmet ve Ödünçler</h4>
                                    <p class="text-muted mb-0">Şu an personelde bulunan aktif cihaz tutanakları.</p>
                                </div>
                                <div class="text-end">
                                    <h2 class="text-white fw-bold mb-2"><t t-esc="state.stats.active_assignments"/> <small class="text-muted fs-6">İşlem</small></h2>
                                    <button class="btn btn-sm btn-outline-light" t-on-click="openAssignments">Detayları Gör <i class="fa fa-arrow-right ms-1"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm" style="background-color: var(--ks-it-surface); border-radius: 12px; border-left: 4px solid var(--ks-it-danger) !important;">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="text-white mb-1">Bekleyen Teknik Servisler</h4>
                                    <p class="text-muted mb-0">İşlemde olan cihaz tamir ve saha müdahaleleri.</p>
                                </div>
                                <div class="text-end">
                                    <h2 class="text-white fw-bold mb-2"><t t-esc="state.stats.active_repairs"/> <small class="text-muted fs-6">Talep</small></h2>
                                    <button class="btn btn-sm btn-outline-light" t-on-click="openRepairs">Detayları Gör <i class="fa fa-arrow-right ms-1"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
