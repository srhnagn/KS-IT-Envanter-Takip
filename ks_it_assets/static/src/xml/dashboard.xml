<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ks_it_assets.Dashboard_Premium" owl="1">
        <div class="o_action_manager">
            <div class="o_ks_dashboard">
                
                <!-- Background Glow Effects -->
                <div class="glow-bg-1"></div>
                <div class="glow-bg-2"></div>

                <!-- Başlık -->
                <div style="margin-bottom: 3rem; position: relative; z-index: 10;">
                    <h2 style="font-weight: 300;">KS IT Asset Manager</h2>
                    <p style="color: #94a3b8;">Kaleseramik Bilgi Teknolojileri Varlık ve Zimmet Yönetimi Özeti</p>
                </div>

                <!-- Özet Kartları (Stats) -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
                    
                    <!-- Toplam Varlık -->
                    <div class="o_ks_card_glass" style="cursor: pointer;" t-on-click="() => this.openAssets([], 'Tüm Varlıklar')">
                        <div class="o_ks_icon_container o_ks_icon_blue">
                            <i class="fa fa-laptop fa-lg"></i>
                        </div>
                        <h3>Toplam IT Varlığı</h3>
                        <div class="ks_stat_value"><t t-esc="state.stats.total_assets"/></div>
                        <p style="color: #64748b; font-size: 0.875rem; margin-top: 1rem;">Sistemdeki kayıtlı tüm IT ekipmanları</p>
                    </div>

                    <!-- Boşta -->
                    <div class="o_ks_card_glass" style="cursor: pointer; border-color: rgba(34, 197, 94, 0.3);" t-on-click="() => this.openAssets([['status', '=', 'available']], 'Boştaki Varlıklar')">
                        <div class="o_ks_icon_container" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                            <i class="fa fa-check-circle fa-lg"></i>
                        </div>
                        <h3>Boşta / Depoda</h3>
                        <div class="ks_stat_value" style="color: #22c55e;"><t t-esc="state.stats.available_assets"/></div>
                        <p style="color: #64748b; font-size: 0.875rem; margin-top: 1rem;">Kullanıma hazır bekleyen donanımlar</p>
                    </div>

                    <!-- Zimmetli -->
                    <div class="o_ks_card_glass" style="cursor: pointer; border-color: rgba(250, 204, 21, 0.3);" t-on-click="() => this.openAssets([['status', '=', 'assigned']], 'Zimmetli Varlıklar')">
                        <div class="o_ks_icon_container o_ks_icon_gold">
                            <i class="fa fa-user fa-lg"></i>
                        </div>
                        <h3>Kullanımda</h3>
                        <div class="ks_stat_value" style="color: #facc15;"><t t-esc="state.stats.assigned_assets"/></div>
                        <p style="color: #64748b; font-size: 0.875rem; margin-top: 1rem;">Personele zimmetlenmiş aktif cihazlar</p>
                    </div>

                    <!-- Tamirde -->
                    <div class="o_ks_card_glass" style="cursor: pointer; border-color: rgba(239, 68, 68, 0.3);" t-on-click="() => this.openAssets([['status', '=', 'repair']], 'Tamirdeki Varlıklar')">
                        <div class="o_ks_icon_container o_ks_icon_red">
                            <i class="fa fa-wrench fa-lg"></i>
                        </div>
                        <h3>Tamirde / Serviste</h3>
                        <div class="ks_stat_value" style="color: #f87171;"><t t-esc="state.stats.in_repair"/></div>
                        <p style="color: #64748b; font-size: 0.875rem; margin-top: 1rem;">Onarım süreci devam eden cihazlar</p>
                    </div>
                </div>

                <!-- Aksiyon Kartları (Bottom Grid) -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
                    
                    <!-- Aktif Zimmetler -->
                    <div class="o_ks_card_glass" style="border-color: rgba(59, 130, 246, 0.2);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <div class="o_ks_icon_container o_ks_icon_blue" style="margin-bottom: 0;">
                                    <i class="fa fa-file-text-o fa-lg"></i>
                                </div>
                                <div>
                                    <h3 style="margin-bottom: 0;">Aktif Zimmet ve Ödünçler</h3>
                                    <p style="color: #94a3b8; font-size: 0.875rem; margin: 0;">Şu an personelde bulunan aktif cihaz tutanakları.</p>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div class="ks_stat_value"><t t-esc="state.stats.active_assignments"/></div>
                                <p style="color: #64748b; font-size: 0.875rem; margin: 0;">İşlem</p>
                            </div>
                        </div>
                        <button style="width: 100%; padding: 0.75rem; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); color: #60a5fa; border-radius: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;" onmouseover="this.style.background='rgba(59, 130, 246, 0.2)'" onmouseout="this.style.background='rgba(59, 130, 246, 0.1)'" t-on-click="openAssignments">
                            Tüm Zimmet Kayıtlarını Gör <i class="fa fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                    
                    <!-- Bekleyen Teknik Servisler -->
                    <div class="o_ks_card_glass" style="border-color: rgba(239, 68, 68, 0.2);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <div class="o_ks_icon_container o_ks_icon_red" style="margin-bottom: 0;">
                                    <i class="fa fa-cogs fa-lg"></i>
                                </div>
                                <div>
                                    <h3 style="margin-bottom: 0;">Bekleyen Teknik Servisler</h3>
                                    <p style="color: #94a3b8; font-size: 0.875rem; margin: 0;">İşlemde olan cihaz tamir ve saha müdahaleleri.</p>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div class="ks_stat_value" style="color: #f87171;"><t t-esc="state.stats.active_repairs"/></div>
                                <p style="color: #64748b; font-size: 0.875rem; margin: 0;">Talep</p>
                            </div>
                        </div>
                        <button style="width: 100%; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; border-radius: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;" onmouseover="this.style.background='rgba(239, 68, 68, 0.2)'" onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'" t-on-click="openRepairs">
                            Teknik Servis Taleplerini Gör <i class="fa fa-arrow-right ms-1"></i>
                        </button>
                    </div>

                </div>

            </div>
        </div>
    </t>
</templates>
