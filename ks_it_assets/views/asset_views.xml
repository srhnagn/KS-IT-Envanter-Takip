<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==============================
         IT Varlık — Tree Görünümü
         ============================== -->
    <record id="view_ks_it_asset_tree" model="ir.ui.view">
        <field name="name">ks.it.asset.tree</field>
        <field name="model">ks.it.asset</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" class="ks-tree-asset"
                  decoration-info="asset_type == 'computer'"
                  decoration-warning="asset_type == 'monitor'"
                  decoration-success="asset_type == 'phone'"
                  decoration-danger="asset_type == 'network'"
                  decoration-primary="asset_type == 'printer'"
                  decoration-muted="asset_type == 'consumable'"
                  decoration-bf="asset_type == 'software'">
                <field name="name" string="Varlık Adı / Departman İçi Barkod"/>
                <field name="asset_type"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="serial_number"/>
                <field name="mac_address" optional="hide"/>
                <field name="purchase_date" optional="hide"/>
                <field name="warranty_display" class="ks-warranty-cell" decoration-danger="warranty_state == 'expired'" decoration-warning="warranty_state == 'warning'" decoration-success="warranty_state == 'valid'"/>
                <field name="warranty_state" column_invisible="1"/>
                <field name="current_assignee_id" string="Kullanıcı" readonly="1"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'assigned'"
                       decoration-danger="status == 'repair'"
                       decoration-muted="status == 'scrapped'"
                       readonly="1"/>
                <button name="action_open_form" type="object"
                        string="Tüm Detayları Düzenle"
                        class="btn-sm btn-secondary"/>
            </tree>
        </field>
    </record>

    <!-- ==============================
         IT Varlık — Kanban Görünümü
         ============================== -->
    <record id="view_ks_it_asset_kanban" model="ir.ui.view">
        <field name="name">ks.it.asset.kanban</field>
        <field name="model">ks.it.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="brand"/>
                <field name="serial_number"/>
                <field name="status"/>
                <field name="current_assignee_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section mt-1">
                                    <span class="badge text-bg-secondary">
                                        <field name="asset_type"/>
                                    </span>
                                </div>
                                <div class="mt-1 text-muted" style="font-size:0.82em;">
                                    S/N: <field name="serial_number"/>
                                </div>
                                <div t-if="record.current_assignee_id.raw_value" class="mt-1" style="font-size:0.82em;">
                                    User: <field name="current_assignee_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==============================
         IT Varlık — Form Görünümü
         ============================== -->
    <record id="view_ks_it_asset_form" model="ir.ui.view">
        <field name="name">ks.it.asset.form</field>
        <field name="model">ks.it.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,assigned,repair,scrapped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Cihaz / Varlık Adı..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Cihaz Bilgileri">
                            <field name="asset_type"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="serial_number"/>
                            <field name="barcode"/>
                            <field name="mac_address"/>
                        </group>
                        <group string="Garanti ve Durum">
                            <field name="purchase_date"/>
                            <field name="warranty_end_date"/>
                            <field name="status"/>
                            <field name="current_assignee_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="internal_notes" placeholder="Cihaza ait özel notlar, konfigürasyon bilgisi vb..."/>
                    </group>
                    <notebook>
                        <page string="Zimmet ve Ödünç Geçmişi">
                            <field name="assignment_ids" readonly="1">
                                <tree class="ks-tree-assign" decoration-success="state == 'active'" decoration-muted="state == 'returned'">
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="assignment_type"/>
                                    <field name="assigned_date"/>
                                    <field name="expected_return_date"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="display_state" string="Durum" widget="badge"
                                           decoration-success="state == 'active' and not (assignment_type == 'temporary' and expected_return_date and expected_return_date &lt; current_date)"
                                           decoration-muted="state == 'returned'"
                                           decoration-danger="assignment_type == 'temporary' and expected_return_date and expected_return_date &lt; current_date and state == 'active'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tamir ve Servis Geçmişi">
                            <field name="repair_ids" readonly="1">
                                <tree class="ks-tree-repair" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'">
                                    <field name="name"/>
                                    <field name="repair_type"/>
                                    <field name="technician_id"/>
                                    <field name="report_date"/>
                                    <field name="issue_description"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==============================
         IT Varlık — Arama Görünümü
         ============================== -->
    <record id="view_ks_it_asset_search" model="ir.ui.view">
        <field name="name">ks.it.asset.search</field>
        <field name="model">ks.it.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="barcode"/>
                <field name="brand"/>
                <field name="current_assignee_id"/>
                <filter string="Boşta" name="filter_available" domain="[('status','=','available')]"/>
                <filter string="Zimmetli" name="filter_assigned" domain="[('status','=','assigned')]"/>
                <filter string="Tamirde" name="filter_repair" domain="[('status','=','repair')]"/>
                <group expand="0" string="Grupla...">
                    <filter string="Varlık Türü" name="group_by_type" context="{'group_by': 'asset_type'}"/>
                    <filter string="Durum" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ks_it_asset" model="ir.actions.act_window">
        <field name="name">IT Varlıkları</field>
        <field name="res_model">ks.it.asset</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
