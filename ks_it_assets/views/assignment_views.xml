<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==============================
         Zimmet — Tree Görünümü
         ============================== -->
    <record id="view_ks_it_assignment_tree" model="ir.ui.view">
        <field name="name">ks.it.assignment.tree</field>
        <field name="model">ks.it.assignment</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'active'"
                  decoration-muted="state == 'returned'"
                  decoration-warning="assignment_type == 'temporary' and expected_return_date and expected_return_date &lt; current_date and state == 'active'">
                <field name="name" string="İşlem Kodu"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="assignment_type" string="Tür"/>
                <field name="assigned_date"/>
                <field name="expected_return_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'returned'"/>
                <button name="action_confirm" type="object"
                        string="Onayla / Zimmetle"
                        class="btn-sm btn-success"
                        invisible="state != 'draft'"/>
                <button name="action_return" type="object"
                        string="İade Al"
                        class="btn-sm btn-warning"
                        invisible="state != 'active'"/>
            </tree>
        </field>
    </record>

    <!-- ==============================
         Zimmet — Form Görünümü
         ============================== -->
    <record id="view_ks_it_assignment_form" model="ir.ui.view">
        <field name="name">ks.it.assignment.form</field>
        <field name="model">ks.it.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            string="Onayla ve Zimmetle" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="ks_it_assets.group_ks_it_admin"/>
                    <button name="action_return" type="object"
                            string="İade Teslim Al" class="btn-warning"
                            invisible="state != 'active'"
                            groups="ks_it_assets.group_ks_it_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="İşlem Bilgileri">
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="assignment_type"/>
                        </group>
                        <group string="Tarihler">
                            <field name="assigned_date"/>
                            <field name="expected_return_date"
                                   invisible="assignment_type == 'permanent'"/>
                            <field name="actual_return_date" readonly="1"
                                   invisible="state != 'returned'"/>
                        </group>
                    </group>
                    <group string="İmzalı Zimmet Belgesi">
                        <field name="document_pdf" widget="binary" filename="document_filename"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Ek açıklamalar, özel koşullar vb..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_ks_it_assignment_search" model="ir.ui.view">
        <field name="name">ks.it.assignment.search</field>
        <field name="model">ks.it.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <filter string="Aktif Zimmetler" name="filter_active" domain="[('state','=','active')]"/>
                <filter string="Geçici Ödünçler" name="filter_temp" domain="[('assignment_type','=','temporary')]"/>
                <filter string="İade Edilenler" name="filter_returned" domain="[('state','=','returned')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ks_it_assignment" model="ir.actions.act_window">
        <field name="name">Zimmet ve Ödünç İşlemleri</field>
        <field name="res_model">ks.it.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
