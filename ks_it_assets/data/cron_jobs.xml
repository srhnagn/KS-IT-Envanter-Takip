<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Garanti Süresi Kontrol Cron Job -->
        <record id="ir_cron_check_warranty_expiry" model="ir.cron">
            <field name="name">KS IT Envanter: Garanti Süresi Kontrolü</field>
            <field name="model_id" ref="model_ks_it_asset"/>
