<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ks_it" model="ir.module.category">
        <field name="name">KS IT Asset Manager</field>
    </record>

    <record id="group_ks_it_user" model="res.groups">
        <field name="name">Kullanıcı</field>
        <field name="category_id" ref="module_category_ks_it"/>
    </record>

    <record id="group_ks_it_admin" model="res.groups">
        <field name="name">Yönetici (IT Müdürü)</field>
        <field name="category_id" ref="module_category_ks_it"/>
        <field name="implied_ids" eval="[(4, ref('group_ks_it_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
